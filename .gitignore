# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files
!*.tfvars
!*.tfvars.example

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for tests
!*test_override.tf
!*test_override.tf.json

# Include fake secrets for tests
!*fake_secrets.tfvars

# CLI configuration files
.terraformrc
terraform.rc

# SSH Keys generated locally
*.pem
*.key

# TFLint cache
.tflint.d/
