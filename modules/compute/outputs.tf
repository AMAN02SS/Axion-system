output "frontend_public_ip" {
  description = "Public IP address of the Frontend VM"
  value       = azurerm_public_ip.frontend_pip.ip_address
}

output "frontend_private_ip" {
  description = "Private IP address of the Frontend VM"
  value       = local.frontend_private_ip
}

output "frontend_vm_id" {
  description = "Resource ID of the Frontend VM"
  value       = azurerm_linux_virtual_machine.frontend_vm.id
}

output "backend_private_ip" {
  description = "Private IP address of the Backend VM"
  value       = local.backend_private_ip
}

output "backend_vm_id" {
  description = "Resource ID of the Backend VM"
  value       = azurerm_linux_virtual_machine.backend_vm.id
}

output "admin_username" {
  description = "Administrator username for the VMs"
  value       = var.admin_username
}

output "ssh_private_key_pem" {
  description = "Generated SSH private key PEM (if generated by Terraform)"
  value       = length(tls_private_key.ssh) > 0 ? tls_private_key.ssh[0].private_key_pem : null
  sensitive   = true
}

output "ssh_public_key_openssh" {
  description = "The SSH public key used for the VMs"
  value       = local.resolved_ssh_public_key
}
